rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    // Define admins once to prevent mistakes
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email in [
          "filemonjose13@gmail.com", 
          "jason4realyt@gmail.com", 
          "angelolienardi@gmail.com"
        ];
    }

    // --- CARTS ---
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // --- ORDERS ---
    match /orders/{orderId} {
      // Must be logged in, and you cannot spoof another user's ID
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Can read if it belongs to you, OR if you are an admin
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      
      // Only admins can update or delete
      allow update, delete: if isAdmin();
    }

    // --- PUBLIC DATA (Products, Events, Gallery) ---
    // Note: If you want these to be readable only by logged-in users, 
    // change "if true" to "if request.auth != null"
    
    match /products/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    
    match /events/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    
    match /gallery/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
  }
}
